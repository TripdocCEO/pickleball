# 정관 피클볼 클럽 — 환경변수 예시
# 운영 배포 전 JGPC_ADMIN_TOKEN 과 JGPC_IP_SALT 는 반드시 바꾸세요.

# 관리자 API 토큰 (체험 신청 조회·글 삭제)
JGPC_ADMIN_TOKEN=change-this-to-a-long-random-string

# IP 해시용 솔트 (접속 IP를 원문 저장하지 않기 위한 값)
JGPC_IP_SALT=change-this-too

# DB 파일 경로 (기본: ./data/club.db)
# JGPC_DB=C:\path\to\club.db

# CORS 허용 오리진 (쉼표 구분)
JGPC_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 분당 쓰기 제한
JGPC_RATE_POST=3
JGPC_RATE_COMMENT=10
JGPC_RATE_TRIAL=3
